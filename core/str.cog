// String operations implemented in Cog over the existing UTF-8 byte API.
use bytes;
use fmt;
use text_order;
use byte_match;
use ascii;
use err::Error;

// Unicode White_Space, expressed as complete UTF-8 sequences. All whitespace
// codepoints fit in one to three bytes. Call only when start < end.
fn whitespace_width(data, start: int, end: int) -> int {
    const first = bytes::get(data, start)!!;
    if first == 32 || (first >= 9 && first <= 13) { return 1; }
    if first != 194 && first != 225 && first != 226 && first != 227 { return 0; }
    if end - start < 2 { return 0; }

    const second = bytes::get(data, start + 1)!!;
    // U+0085 NEXT LINE, U+00A0 NO-BREAK SPACE.
    if first == 194 && (second == 133 || second == 160) { return 2; }
    if end - start < 3 { return 0; }

    const third = bytes::get(data, start + 2)!!;
    // U+1680 OGHAM SPACE MARK.
    if first == 225 && second == 154 && third == 128 { return 3; }
    if first == 226 {
        // U+2000..U+200A, U+2028, U+2029, U+202F.
        if second == 128 && (
            (third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175
        ) { return 3; }
        // U+205F MEDIUM MATHEMATICAL SPACE.
        if second == 129 && third == 159 { return 3; }
    }
    // U+3000 IDEOGRAPHIC SPACE.
    if first == 227 && second == 128 && third == 128 { return 3; }
    0
}

fn trailing_whitespace_width(data, start: int, end: int) -> int {
    const last = bytes::get(data, end - 1)!!;
    if last == 32 || (last >= 9 && last <= 13) { return 1; }
    if last < 128 { return 0; }
    if end - start >= 2 && whitespace_width(data, end - 2, end)!! == 2 { return 2; }
    if end - start >= 3 && whitespace_width(data, end - 3, end)!! == 3 { return 3; }
    0
}

fn trim_impl(text: str, left: bool, right: bool) -> str {
    const data = bytes::from_str(text)!!;
    const length = bytes::len(data);
    var start = 0;
    var end = length;

    while left && start < end {
        const width = whitespace_width(data, start, end)!!;
        if width == 0 { break; }
        start += width;
    }
    while right && start < end {
        const width = trailing_whitespace_width(data, start, end)!!;
        if width == 0 { break; }
        end -= width;
    }

    if start == 0 && end == length {
        text
    } else {
        bytes::to_str(data, start, end - start)
    }
}

// Remove Unicode whitespace at both ends, leaving the input unchanged.
public fn trim(text: str) -> str {
    trim_impl(text, true, true)
}

// Remove Unicode whitespace at the start, leaving the input unchanged.
public fn trim_start(text: str) -> str {
    trim_impl(text, true, false)
}

// Remove Unicode whitespace at the end, leaving the input unchanged.
public fn trim_end(text: str) -> str {
    trim_impl(text, false, true)
}

public fn starts_with(text: str, prefix: str) -> bool {
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(prefix)!!;
    const length = bytes::len(needle)!!;
    if length > bytes::len(data)!! { return false; }
    byte_match::matches_at(data, 0, needle, length)
}

public fn ends_with(text: str, suffix: str) -> bool {
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(suffix)!!;
    const length = bytes::len(needle)!!;
    const offset = bytes::len(data)!! - length;
    if offset < 0 { return false; }
    byte_match::matches_at(data, offset, needle, length)
}

public fn contains(text: str, part: str) -> bool {
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(part)!!;
    const length = bytes::len(needle)!!;
    const last = bytes::len(data)!! - length;
    var offset = 0;
    while offset <= last {
        if byte_match::matches_at(data, offset, needle, length)!! { return true; }
        offset += 1;
    }
    false
}

// Replace non-overlapping matches from left to right without normalizing text.
public fn replace(text: str, pattern: str, replacement: str) -> str {
    text!!;
    pattern!!;
    replacement!!;
    if pattern == "" { return Error::InvalidArgument("str::replace"); }

    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(pattern)!!;
    const inserted = bytes::from_str(replacement)!!;
    const length = bytes::len(data)!!;
    const needle_length = bytes::len(needle)!!;
    const inserted_length = bytes::len(inserted)!!;

    var matches = 0;
    var offset = 0;
    while offset <= length - needle_length {
        if byte_match::matches_at(data, offset, needle, needle_length)!! {
            matches += 1;
            offset += needle_length;
        } else {
            offset += 1;
        }
    }
    if matches == 0 { return text; }

    const result_length =
        (length + matches * (inserted_length - needle_length))!!;
    var result = bytes::new(result_length)!!;
    var source = 0;
    var output = 0;
    offset = 0;

    while offset <= length - needle_length {
        if byte_match::matches_at(data, offset, needle, needle_length)!! {
            while source < offset {
                bytes::set(result, output, bytes::get(data, source)!!)!!;
                source += 1;
                output += 1;
            }
            for index in 0..inserted_length {
                bytes::set(result, output, bytes::get(inserted, index)!!)!!;
                output += 1;
            }
            offset += needle_length;
            source = offset;
        } else {
            offset += 1;
        }
    }
    while source < length {
        bytes::set(result, output, bytes::get(data, source)!!)!!;
        source += 1;
        output += 1;
    }
    bytes::to_str(result, 0, result_length)
}

public fn compare(left: str, right: str) -> int {
    text_order::compare(left, right)
}

// Exact, non-overlapping separators. Preserve leading/trailing empty fields.
public fn split(text: str, separator: str) -> str[] {
    text!!;
    separator!!;
    if separator == "" { return Error::InvalidArgument("str::split"); }
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(separator)!!;
    const length = bytes::len(needle)!!;
    const end = bytes::len(data)!!;
    var result: str[] = [];
    var start = 0;
    var offset = 0;
    while offset <= end - length {
        if byte_match::matches_at(data, offset, needle, length)!! {
            result.append(bytes::to_str(data, start, offset - start)!!)!!;
            offset += length;
            start = offset;
        } else {
            offset += 1;
        }
    }
    result.append(bytes::to_str(data, start, end - start)!!)!!;
    result
}

// Fields are the runs between Unicode whitespace, as recognized by trim.
// Empty fields are never produced.
public fn split_whitespace(text: str) -> str[] {
    const data = bytes::from_str(text)!!;
    const length = bytes::len(data)!!;
    var result: str[] = [];
    var start = 0;
    var offset = 0;
    while offset < length {
        const width = whitespace_width(data, offset, length)!!;
        if width == 0 {
            offset += 1;
        } else {
            if offset > start {
                result.append(bytes::to_str(data, start, offset - start)!!)!!;
            }
            offset += width;
            start = offset;
        }
    }
    if length > start {
        result.append(bytes::to_str(data, start, length - start)!!)!!;
    }
    result
}

// The byte offset that follows `scalars` Unicode scalars from the boundary at
// `from`. The caller ensures the text holds that many.
fn skip_scalars(data, from: int, scalars: int) -> int {
    const length = bytes::len(data)!!;
    var offset = from;
    for _ in 0..scalars {
        offset += 1;
        while offset < length {
            const byte = bytes::get(data, offset)!!;
            if byte < 128 || byte >= 192 { break; }
            offset += 1;
        }
    }
    offset
}

// Offsets and counts are Unicode scalars. Out-of-range requests are not clamped.
public fn slice(text: str, offset: int, count: int) -> str {
    text!!;
    offset!!;
    count!!;
    const length = len(text);
    if offset < 0 || offset > length || count < 0 || count > length - offset {
        return Error::InvalidArgument("str::slice");
    }
    if count == length { return text; }
    const data = bytes::from_str(text)!!;
    const start = skip_scalars(data, 0, offset)!!;
    const end = skip_scalars(data, start, count)!!;
    bytes::to_str(data, start, end - start)
}

public fn join(parts, separator: str = "") -> str {
    // Validate even an empty input without mutating the caller's array.
    parts!!;
    when parts is str { return Error::TypeMismatch("array::is_empty"); }
    const length = len(parts)!!;
    separator!!;
    var result = str::builder()!!;
    for index in 0..length {
        const part = parts[index]!!;
        when part is str {} else { return Error::TypeMismatch("str::join"); }
        if index > 0 { fmt::write(result, "{}", separator)!!; }
        fmt::write(result, "{}", part)!!;
    }
    str::build(result)
}

fn scalar_offset(data, position: int) -> int? {
    if position < 0 { return nil; }
    var offset = 0;
    for i in 0..position {
        const byte = bytes::get(data, i)!!;
        if byte < 128 || byte >= 192 { offset += 1; }
    }
    offset
}

public fn find(text: str, pattern: str) -> int? {
    text!!;
    pattern!!;
    if pattern == "" { return 0; }
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(pattern)!!;
    scalar_offset(data, byte_match::first(data, needle, 0)!!)!!
}

public fn rfind(text: str, pattern: str) -> int? {
    text!!;
    pattern!!;
    if pattern == "" { return len(text); }
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(pattern)!!;
    scalar_offset(data, byte_match::last(data, needle)!!)!!
}

public fn count(text: str, pattern: str) -> int {
    text!!;
    pattern!!;
    if pattern == "" { return Error::InvalidArgument("str::count"); }
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(pattern)!!;
    byte_match::count(data, needle)
}

fn split_pair(text: str, separator: str, first_only: bool) -> (str, str) {
    text!!;
    separator!!;
    if separator == "" { return Error::InvalidArgument("str::split_once"); }
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(separator)!!;
    const middle = if first_only {
        byte_match::first(data, needle, 0)!!
    } else {
        byte_match::last(data, needle)!!
    };
    if middle < 0 { return Error::MissingKey(); }
    const right = middle + bytes::len(needle)!!;
    (bytes::to_str(data, 0, middle)!!, bytes::to_str(data, right, bytes::len(data)!! - right)!!)
}

public fn split_once(text: str, separator: str) -> (str, str) {
    split_pair(text, separator, true)
}

public fn rsplit_once(text: str, separator: str) -> (str, str) {
    split_pair(text, separator, false)
}

public fn lines(text: str) -> str[] {
    const data = bytes::from_str(text)!!;
    const length = bytes::len(data)!!;
    var result: str[] = [];
    var start = 0;
    for i in 0..length {
        if bytes::get(data, i)!! == 10 {
            const end = if i > start && bytes::get(data, i - 1)!! == 13 { i - 1 } else { i };
            result.append(bytes::to_str(data, start, end - start)!!)!!;
            start = i + 1;
        }
    }
    if start < length { result.append(bytes::to_str(data, start, length - start)!!)!!; }
    result
}

public fn repeat(text: str, count: int) -> str {
    text!!;
    count!!;
    if count < 0 { return Error::InvalidArgument("str::repeat"); }
    if count == 0 || text == "" { return ""; }
    const data = bytes::from_str(text)!!;
    const width = bytes::len(data)!!;
    const length = (width * count)!!;
    var result = bytes::new(length)!!;
    var offset = 0;
    for _ in 0..count {
        for i in 0..width {
            bytes::set(result, offset, bytes::get(data, i)!!)!!;
            offset += 1;
        }
    }
    bytes::to_str(result, 0, length)
}

fn remove_affix(text: str, pattern: str, prefix: bool) -> str {
    text!!;
    pattern!!;
    if pattern == "" { return text; }
    const data = bytes::from_str(text)!!;
    const needle = bytes::from_str(pattern)!!;
    const width = bytes::len(needle)!!;
    const remaining = bytes::len(data)!! - width;
    if remaining < 0 { return text; }
    const offset = if prefix { 0 } else { remaining };
    if !byte_match::matches_at(data, offset, needle, width)!! { return text; }
    bytes::to_str(data, if prefix { width } else { 0 }, remaining)
}

public fn remove_prefix(text: str, prefix: str) -> str {
    remove_affix(text, prefix, true)
}

public fn remove_suffix(text: str, suffix: str) -> str {
    remove_affix(text, suffix, false)
}

// The number of UTF-8 bytes; len(text) counts Unicode scalars instead.
public fn byte_len(text: str) -> int {
    bytes::len(bytes::from_str(text)!!)
}

// Strictly decode a whole buffer as UTF-8.
public fn from_bytes(data: bytes) -> str {
    bytes::to_str(data, 0, bytes::len(data)!!)
}

fn padding(text: str, width: int, fill: char, operation: str) -> str {
    text!!;
    width!!;
    fill!!;
    if width < 0 { return Error::InvalidArgument(operation); }
    const missing = width - len(text);
    if missing <= 0 { return ""; }
    repeat(str::to_str(fill)!!, missing)
}

// Widths count Unicode scalars. Longer text is returned whole.
public fn pad_start(text: str, width: int, fill: char = ' ') -> str {
    padding(text, width, fill, "str::pad_start")!! + text
}

public fn pad_end(text: str, width: int, fill: char = ' ') -> str {
    const added = padding(text, width, fill, "str::pad_end")!!;
    text + added
}

// True for empty text and text made only of Unicode whitespace.
public fn is_blank(text: str) -> bool {
    trim(text)!! == ""
}

// Only ASCII bytes change, so multi-byte UTF-8 sequences stay intact.
fn change_ascii_case(text: str, uppercase: bool) -> str {
    var data = bytes::from_str(text)!!;
    const length = bytes::len(data)!!;
    for index in 0..length {
        const byte = bytes::get(data, index)!!;
        const changed =
            if uppercase { ascii::to_uppercase(byte)!! } else { ascii::to_lowercase(byte)!! };
        bytes::set(data, index, changed)!!;
    }
    bytes::to_str(data, 0, length)
}

public fn to_ascii_lowercase(text: str) -> str {
    change_ascii_case(text, false)
}

public fn to_ascii_uppercase(text: str) -> str {
    change_ascii_case(text, true)
}

// Compare while ignoring the case of ASCII letters only.
public fn equals_ignore_ascii_case(a: str, b: str) -> bool {
    const left = bytes::from_str(a)!!;
    const right = bytes::from_str(b)!!;
    const length = bytes::len(left)!!;
    if length != bytes::len(right)!! { return false; }
    for index in 0..length {
        const first = ascii::to_lowercase(bytes::get(left, index)!!)!!;
        if first != ascii::to_lowercase(bytes::get(right, index)!!)!! { return false; }
    }
    true
}

// The fallback replaces only a ParseFailure; other errors still propagate.
public fn to_int_or(text: str, fallback: int) -> int {
    text!!;
    fallback!!;
    const parsed = str::to_int(text);
    when parsed is Error::ParseFailure { return fallback; } else {}
    parsed
}
