// Array utilities preserve element references and never mutate their inputs.
use array_storage;
use collections::{Hashable, Map, Set};
use eq::Eq;
use err::Error;
use ord::Ord;

fn array_length(items, operation: str) -> int {
    items!!;
    when items is str { return Error::TypeMismatch(operation); }
    len(items)
}

public fn is_empty(items) -> bool {
    array_length(items, "array::is_empty")!! == 0
}

public fn first(items) {
    if array_length(items, "array::first")!! == 0 { return nil; }
    items[0]
}

public fn last(items) {
    const length = array_length(items, "array::last")!!;
    if length == 0 { return nil; }
    items[length - 1]
}

// Equality follows the language's == operator, including its errors.
public fn index_of(items, value) -> int? {
    const length = array_length(items, "array::index_of")!!;
    value!!;
    for index in 0..length {
        if (items[index] == value)!! { return index; }
    }
    nil
}

public fn contains(items, value) -> bool {
    index_of(items, value)!! != nil
}

// Higher-order operations call a synchronous function once per selected item.
public fn map[T: type, U: type](items: T[], transform: fn(T) -> U) -> U[] {
    var result: U[] = [];
    for item in items {
        result << (transform)(item)!!;
    }
    result
}

public fn filter[T: type](items: T[], predicate: fn(T) -> bool) -> T[] {
    var result: T[] = [];
    for item in items {
        if (predicate)(item)!! { result << item; }
    }
    result
}

public fn fold[T: type, U: type](
    items: T[],
    initial: U,
    combine: fn(U, T) -> U,
) -> U {
    var result = initial;
    for item in items {
        result = (combine)(result, item)!!;
    }
    result
}

// A statically typed equality search. Unlike index_of, this requires an Eq
// implementation and rejects unsupported element types during compilation.
public fn position[T: type + Eq[T]](items: T[], value: T) -> int? {
    value!!;
    const length = len(items);
    for index in 0..length {
        const item = items[index]!!;
        if item.equals(value) { return index; }
    }
    nil
}

// Select an existing element; arrays remain unchanged and shared values stay shared.
public fn min[T: type + Ord](items: T[]) -> T {
    const length = len(items);
    if length == 0 { return Error::InvalidArgument("array::min"); }
    var smallest = items[0]!!;
    for index in 1..length {
        const item = items[index]!!;
        if item.compare(smallest) < 0 { smallest = item; }
    }
    smallest
}

public fn max[T: type + Ord](items: T[]) -> T {
    const length = len(items);
    if length == 0 { return Error::InvalidArgument("array::max"); }
    var largest = items[0]!!;
    for index in 1..length {
        const item = items[index]!!;
        if item.compare(largest) > 0 { largest = item; }
    }
    largest
}

// A fresh outer array; nested arrays and other shared elements remain aliases.
public fn slice(items, offset: int, count: int) {
    const length = array_length(items, "array::slice")!!;
    offset!!;
    count!!;
    if offset < 0 || offset > length || count < 0 || count > length - offset {
        return Error::InvalidArgument("array::slice");
    }
    var result = items.empty_like()!!;
    for index in offset..(offset + count) { result << items[index]!!; }
    result
}

public fn reversed(items) {
    const length = array_length(items, "array::reversed")!!;
    var result = items.empty_like()!!;
    var index = length;
    while index > 0 {
        index -= 1;
        result << items[index]!!;
    }
    result
}

public fn concat(left, right) {
    const left_length = array_length(left, "array::concat")!!;
    const right_length = array_length(right, "array::concat")!!;
    var result = left.empty_like()!!;
    for index in 0..left_length { result << left[index]!!; }
    for index in 0..right_length { result << right[index]!!; }
    const compatible = left.empty_like()!! + right.empty_like()!!;
    compatible!!;
    result
}

// Predicates visit elements in order and short-circuit once the answer is known.
public fn any[T: type](items: T[], predicate: fn(T) -> bool) -> bool {
    for item in items {
        if (predicate)(item)!! { return true; }
    }
    false
}

public fn all[T: type](items: T[], predicate: fn(T) -> bool) -> bool {
    for item in items {
        if !(predicate)(item)!! { return false; }
    }
    true
}

public fn find_index[T: type](items: T[], predicate: fn(T) -> bool) -> int? {
    var index = 0;
    for item in items {
        if (predicate)(item)!! { return index; }
        index += 1;
    }
    nil
}

public fn find[T: type](items: T[], predicate: fn(T) -> bool) -> T {
    for item in items {
        if (predicate)(item)!! { return item; }
    }
    Error::MissingKey()
}

public fn count_if[T: type](items: T[], predicate: fn(T) -> bool) -> int {
    var count = 0;
    for item in items {
        if (predicate)(item)!! { count += 1; }
    }
    count
}

fn copy_range[T: type](items: T[], start: int, end: int) -> T[] {
    var result: T[] = [];
    for index in start..end { (result << items[index]!!)!!; }
    result
}

public fn take[T: type](items: T[], count: int) -> T[] {
    if count < 0 { return Error::InvalidArgument("array::take"); }
    const end = if count < items.len() { count } else { items.len() };
    copy_range(items, 0, end)
}

public fn drop[T: type](items: T[], count: int) -> T[] {
    if count < 0 { return Error::InvalidArgument("array::drop"); }
    const start = if count < items.len() { count } else { items.len() };
    copy_range(items, start, items.len())
}

public fn partition[T: type](items: T[], predicate: fn(T) -> bool) -> (T[], T[]) {
    var selected: T[] = [];
    var rejected: T[] = [];
    for item in items {
        if (predicate)(item)!! { (selected << item)!!; }
        else { (rejected << item)!!; }
    }
    (selected, rejected)
}

public fn flatten[T: type](items: T[][]) -> T[] {
    var result: T[] = [];
    for part in items {
        for item in part { (result << item)!!; }
    }
    result
}

public fn flat_map[T: type, U: type](items: T[], transform: fn(T) -> U[]) -> U[] {
    var result: U[] = [];
    for item in items {
        const part = (transform)(item)!!;
        for mapped in part { (result << mapped)!!; }
    }
    result
}

public fn zip[T: type, U: type](left: T[], right: U[]) -> (T, U)[] {
    var result: (T, U)[] = [];
    const end = if left.len() < right.len() { left.len() } else { right.len() };
    for index in 0..end { (result << (left[index]!!, right[index]!!))!!; }
    result
}

public fn enumerate[T: type](items: T[]) -> (int, T)[] {
    var result: (int, T)[] = [];
    for index in 0..items.len() { (result << (index, items[index]!!))!!; }
    result
}

public fn chunks[T: type](items: T[], size: int) -> T[][] {
    if size <= 0 { return Error::InvalidArgument("array::chunks"); }
    var result: T[][] = [];
    var start = 0;
    while start < items.len() {
        const remaining = items.len() - start;
        const count = if size < remaining { size } else { remaining };
        const end = start + count;
        (result << copy_range(items, start, end)!!)!!;
        start = end;
    }
    result
}

public fn windows[T: type](items: T[], size: int) -> T[][] {
    if size <= 0 { return Error::InvalidArgument("array::windows"); }
    var result: T[][] = [];
    if size > items.len() { return result; }
    for start in 0..(items.len() - size + 1) {
        (result << copy_range(items, start, start + size)!!)!!;
    }
    result
}

public fn dedup[T: type + Eq[T]](items: T[]) -> T[] {
    var result: T[] = [];
    for index in 0..items.len() {
        const item = items[index]!!;
        if result.len() == 0 || !item.equals(result[result.len() - 1]!!)!! {
            (result << item)!!;
        }
    }
    result
}

public fn scan[T: type, U: type](items: T[], initial: U, combine: fn(U, T) -> U) -> U[] {
    var result: U[] = [];
    var accumulator = initial;
    for item in items {
        accumulator = (combine)(accumulator, item)!!;
        (result << accumulator)!!;
    }
    result
}

// Deduplicates by Hashable while retaining the first representative of each key.
public fn unique[T: type + Hashable](items: T[]) -> T[] {
    var seen = Set::new[T]();
    var result: T[] = [];
    for item in items {
        if seen.insert(item)!! { (result << item)!!; }
    }
    result
}

public fn group_by[T: type, K: type + Hashable](items: T[], key: fn(T) -> K) -> Map[K, T[]] {
    var result = Map::new[K, T[]]();
    for item in items {
        var empty: T[] = [];
        var group = result.get_or_insert((key)(item)!!, empty)!!;
        (group << item)!!;
    }
    result
}
