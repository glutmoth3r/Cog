use array_storage;
use err::Error;
use entropy;
use bytes;

// A 31-bit linear congruential generator, seeded once from OS entropy.
const MODULUS = 2147483648;
const UINT_MODULUS: uint = 2147483648;
var state = 0;
var initialized = false;

fn ensure_seeded() {
    if !initialized {
        const raw = entropy::bytes(4)!!;
        state = seed_from_bytes(raw)!! % MODULUS;
        initialized = true;
    }
    return nil;
}

fn seed_from_bytes(raw) {
    var acc = 0;
    var i = 0;
    while i < bytes::len(raw) {
        acc = acc * 256 + bytes::get(raw, i)!!;
        i = i + 1;
    }
    return acc;
}

public fn next() {
    ensure_seeded()!!;
    state = (state * 1103515245 + 12345) % MODULUS;
    return state;
}

public fn range(lo, hi) {
    const low = range_bound(lo)!!;
    const high = range_bound(hi)!!;
    if high <= low { return Error::InvalidArgument("random::range"); }
    const width = (high - low)!!;
    if width > MODULUS { return Error::InvalidArgument("random::range"); }
    // Discard the incomplete remainder interval instead of biasing smaller values.
    const limit = MODULUS - MODULUS % width;
    var value = next()!!;
    while value >= limit { value = next()!!; }
    return low + value % width;
}

public fn range_uint(lo: uint, hi: uint) -> uint {
    if hi <= lo { return Error::InvalidArgument("random::range_uint"); }
    const width = (hi - lo)!!;
    if width > UINT_MODULUS {
        return Error::InvalidArgument("random::range_uint");
    }
    const limit = UINT_MODULUS - UINT_MODULUS % width;
    const initial = next()!!;
    var value: uint = (initial as uint)!!;
    while value >= limit {
        const sample = next()!!;
        value = (sample as uint)!!;
    }
    lo + value % width
}

fn range_bound(value) {
    value!!;
    when value is int { value } else { Error::TypeMismatch("random::range") }
}

public fn boolean() {
    return next()!! >= MODULUS / 2;
}

// Independent deterministic streams. This is the same non-cryptographic LCG
// as the default generator, without an entropy dependency.
public struct Seeded {
    private state: int
}

extend Seeded {
    public fn new(seed: int) -> Self {
        var normalized = seed!! % MODULUS;
        if normalized < 0 { normalized += MODULUS; }
        Seeded(state: normalized)
    }

    public fn next(mut self) -> int {
        self.state = (self.state * 1103515245 + 12345) % MODULUS;
        self.state
    }

    public fn range(mut self, lo: int, hi: int) -> int {
        lo!!;
        hi!!;
        if hi <= lo { return Error::InvalidArgument("Seeded::range"); }
        const width = (hi - lo)!!;
        if width > MODULUS { return Error::InvalidArgument("Seeded::range"); }
        const limit = MODULUS - MODULUS % width;
        var sample = self.next()!!;
        while sample >= limit { sample = self.next()!!; }
        lo + sample % width
    }
}

public fn choose[T: type](rng: Seeded, items: T[]) -> T {
    if items.len() == 0 { return Error::InvalidArgument("random::choose"); }
    items[rng.range(0, items.len())!!]
}

public fn shuffle[T: type](rng: Seeded, items: T[]) -> nil {
    if items.len() > MODULUS { return Error::InvalidArgument("random::shuffle"); }
    var end = items.len();
    while end > 1 {
        items.swap(end - 1, rng.range(0, end)!!)!!;
        end -= 1;
    }
    nil
}

public fn sample[T: type](rng: Seeded, items: T[], count: int) -> T[] {
    count!!;
    if count < 0 || count > items.len() || items.len() > MODULUS {
        return Error::InvalidArgument("random::sample");
    }
    var result: T[] = [];
    if count == 0 { return result; }
    var pool: T[] = [];
    for item in items { pool.append(item)!!; }
    for index in 0..count {
        const selected = rng.range(index, pool.len())!!;
        pool.swap(index, selected)!!;
        result.append(pool[index]!!)!!;
    }
    result
}
