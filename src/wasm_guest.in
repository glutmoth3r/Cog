#![allow(dead_code, unused_assignments, unused_mut, unused_variables)]

use std::borrow::Cow;
use std::cell::{Cell, RefCell};
use std::cmp::Ordering;
use std::collections::HashMap;
use std::io::Write;
use std::rc::Rc;

#[derive(Clone)]
enum V {
    Nil,
    Int(i64),
    UInt(u64),
    Bool(bool),
    Char(char),
    Str(Rc<str>),
    Tag(Rc<str>),
    // Shared and mutable like VM arrays and structs: aliases observe writes.
    // Reference cycles are never collected; their memory is released at exit.
    Array(Rc<ArrayObj>),
    Record(Rc<RecordObj>),
    Iterator(Rc<RefCell<Iteration>>),
    // Shared and mutable like the VM's byte buffers: aliases observe writes.
    Bytes(Rc<RefCell<Vec<u8>>>),
    StrBuf(Rc<RefCell<String>>),
    Stdout,
    Error(Fault),
}

#[derive(Clone)]
struct Fault {
    kind: Cow<'static, str>,
    pc: usize,
    detail: Detail,
}

#[derive(Clone)]
enum Detail {
    None,
    Operation(&'static str),
    Index(i64, usize),
    Parse(&'static str, &'static str),
    Resource(&'static str),
    Fields(Rc<Fields>),
    IoWrite(Rc<str>),
    Missing(Rc<str>),
}

impl Fault {
    fn new(kind: &'static str, pc: usize) -> Self {
        Self {
            kind: Cow::Borrowed(kind),
            pc,
            detail: Detail::None,
        }
    }
    fn value(kind: &'static str, pc: usize, detail: Detail) -> V {
        V::Error(Self {
            kind: Cow::Borrowed(kind),
            pc,
            detail,
        })
    }
    fn tag(&self) -> String {
        format!("$core::err::Error::{}", self.kind)
    }
    fn field(&self, field: &str) -> Option<V> {
        match (&self.detail, field) {
            (Detail::Operation(op), "op") => Some(V::Str((*op).into())),
            (Detail::Index(index, _), "index") => Some(V::Int(*index)),
            (Detail::Index(_, len), "len") => Some(V::Int(*len as i64)),
            (Detail::Parse(from, _), "from") => Some(V::Str((*from).into())),
            (Detail::Parse(_, to), "to") => Some(V::Str((*to).into())),
            (Detail::Resource(resource), "resource") => Some(V::Str((*resource).into())),
            (Detail::Fields(fields), name) => fields
                .0
                .iter()
                .find(|(key, _)| &**key == name)
                .map(|(_, value)| value.clone()),
            (Detail::IoWrite(message), "message") => Some(V::Str(message.clone())),
            (Detail::Missing(field), "field") => Some(V::Str(field.clone())),
            _ => None,
        }
    }
    fn message(&self) -> String {
        match (&self.detail, &*self.kind) {
            (_, "Overflow") => "integer arithmetic overflow".into(),
            (_, "DivisionByZero") => "division by zero".into(),
            (Detail::Operation(op), "TypeMismatch") => format!("type mismatch in `{op}`"),
            (Detail::Operation(op), "InvalidArgument") => format!("invalid argument in `{op}`"),
            (Detail::Index(index, len), _) => format!("index {index} out of bounds (length {len})"),
            (Detail::IoWrite(message), _) => format!("failed to write output: {message}"),
            (Detail::Parse(from, to), _) => format!("cannot parse {from} as {to}"),
            (Detail::Resource(resource), _) => format!("runtime resource limit: {resource}"),
            (Detail::Fields(fields), _) if fields.0.is_empty() => self.kind.to_string(),
            (Detail::Fields(fields), _) => {
                let mut text = String::new();
                match render_fields(&mut text, &fields.0, 0, "str") {
                    Ok(()) => text,
                    Err(_) => format!("{} with unrenderable fields", self.kind),
                }
            }
            (Detail::Missing(field), _) => format!("missing field `{field}`"),
            _ => self.kind.to_string(),
        }
    }
}

type Run = Result<(V, bool), Fault>;

struct State {
    globals: [Option<V>; GLOBAL_SLOTS],
    /// Array and field contracts referenced by the generated code.
    types: Vec<Ty>,
}

fn main() {
    let mut state = State {
        globals: std::array::from_fn(|_| None),
        types: contract_types(),
    };
    if let Err(error) = f_0(&mut state, 0, []) {
        eprintln!(
            "Error::{}: {}\nOrigin: {}",
            error.kind,
            error.message(),
            site(error.pc)
        );
        std::process::exit(1);
    }
}

fn take(value: &mut V) -> V {
    std::mem::replace(value, V::Nil)
}

fn type_mismatch(pc: usize, op: &'static str) -> V {
    Fault::value("TypeMismatch", pc, Detail::Operation(op))
}

fn condition(value: V, pc: usize) -> Result<bool, Fault> {
    match value {
        V::Bool(value) => Ok(value),
        V::Error(error) => Err(error),
        _ => Err(Fault::new("TypeMismatch", pc)),
    }
}

fn unary_not(value: V, pc: usize) -> V {
    match value {
        V::Bool(value) => V::Bool(!value),
        V::Error(_) => value,
        _ => type_mismatch(pc, "not"),
    }
}

fn logic(
    a: V,
    b: V,
    operation: impl FnOnce(bool, bool) -> bool,
    pc: usize,
    name: &'static str,
) -> V {
    match (a, b) {
        (error @ V::Error(_), _) | (_, error @ V::Error(_)) => error,
        (V::Bool(a), V::Bool(b)) => V::Bool(operation(a, b)),
        _ => type_mismatch(pc, name),
    }
}

macro_rules! arithmetic {
    ($name:ident, $method:ident, $op:literal, $division:literal) => {
        fn $name(a: V, b: V, pc: usize) -> V {
            let overflow = || V::Error(Fault::new("Overflow", pc));
            match (a, b) {
                (error @ V::Error(_), _) | (_, error @ V::Error(_)) => error,
                (V::Int(_), V::Int(0)) | (V::UInt(_), V::UInt(0)) if $division => {
                    V::Error(Fault::new("DivisionByZero", pc))
                }
                (V::Int(a), V::Int(b)) => a.$method(b).map_or_else(overflow, V::Int),
                (V::UInt(a), V::UInt(b)) => a.$method(b).map_or_else(overflow, V::UInt),
                _ => type_mismatch(pc, $op),
            }
        }
    };
}
arithmetic!(add_number, checked_add, "add", false);
arithmetic!(sub, checked_sub, "sub", false);
arithmetic!(mul, checked_mul, "mul", false);
arithmetic!(div, checked_div, "div", true);
arithmetic!(rem, checked_rem, "mod", true);

// Mirrors the VM's checked shifts: amounts outside 0..64 are invalid
// arguments, and left shifts that lose significant bits overflow.
fn shift(a: V, b: V, left: bool, pc: usize) -> V {
    let op = if left { "shl" } else { "shr" };
    let amount = match &b {
        V::Int(amount) => i128::from(*amount),
        V::UInt(amount) => i128::from(*amount),
        _ => i128::MIN,
    };
    match (a, b) {
        (error @ V::Error(_), _) | (_, error @ V::Error(_)) => error,
        (V::Int(_) | V::UInt(_), _) if amount == i128::MIN => type_mismatch(pc, op),
        (V::Int(_) | V::UInt(_), _) if !(0..64).contains(&amount) => {
            Fault::value("InvalidArgument", pc, Detail::Operation(op))
        }
        (V::Int(value), _) if left => {
            let result = value << amount;
            if result >> amount == value { V::Int(result) } else { V::Error(Fault::new("Overflow", pc)) }
        }
        (V::UInt(value), _) if left => {
            let result = value << amount;
            if result >> amount == value { V::UInt(result) } else { V::Error(Fault::new("Overflow", pc)) }
        }
        (V::Int(value), _) => V::Int(value >> amount),
        (V::UInt(value), _) => V::UInt(value >> amount),
        _ => type_mismatch(pc, op),
    }
}

fn add(a: V, b: V, pc: usize) -> V {
    match (a, b) {
        (error @ V::Error(_), _) | (_, error @ V::Error(_)) => error,
        (V::Str(a), V::Str(b)) => V::Str((a.to_string() + &b).into()),
        (V::Array(a), b) => append_to_copy(&a, b, pc),
        (a, V::Array(b)) => prepend_to_copy(a, &b, pc),
        (a, b) => add_number(a, b, pc),
    }
}

enum Order {
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
}

impl Order {
    fn name(&self) -> &'static str {
        match self {
            Self::Eq => "eq",
            Self::Ne => "ne",
            Self::Lt => "lt",
            Self::Le => "le",
            Self::Gt => "gt",
            Self::Ge => "ge",
        }
    }
}

fn compare(a: V, b: V, operation: Order, pc: usize) -> V {
    let equality = matches!(operation, Order::Eq | Order::Ne);
    let order = match (a, b) {
        (error @ V::Error(_), _) | (_, error @ V::Error(_)) => return error,
        (V::Int(a), V::Int(b)) => a.cmp(&b),
        (V::UInt(a), V::UInt(b)) => a.cmp(&b),
        (V::Int(a), V::UInt(b)) => i128::from(a).cmp(&i128::from(b)),
        (V::UInt(a), V::Int(b)) => i128::from(a).cmp(&i128::from(b)),
        (V::Char(a), V::Char(b)) => a.cmp(&b),
        (V::Bool(a), V::Bool(b)) if equality => a.cmp(&b),
        (V::Str(a), V::Str(b)) | (V::Tag(a), V::Tag(b)) if equality => a.cmp(&b),
        (V::Nil, V::Nil) if equality => Ordering::Equal,
        (a, b) if equality && std::mem::discriminant(&a) != std::mem::discriminant(&b) => {
            Ordering::Less
        }
        _ => return type_mismatch(pc, operation.name()),
    };
    V::Bool(match operation {
        Order::Eq => order.is_eq(),
        Order::Ne => order.is_ne(),
        Order::Lt => order.is_lt(),
        Order::Le => order.is_le(),
        Order::Gt => order.is_gt(),
        Order::Ge => order.is_ge(),
    })
}

fn length(value: V, pc: usize) -> V {
    match value {
        V::Str(text) => V::Int(text.chars().count() as i64),
        V::Array(array) => match array.items.try_borrow() {
            Ok(items) => V::Int(items.len() as i64),
            Err(_) => invalid_argument(pc, "len"),
        },
        V::Error(_) => value,
        _ => type_mismatch(pc, "len"),
    }
}

fn missing_field(field: Rc<str>, pc: usize) -> V {
    Fault::value("MissingField", pc, Detail::Missing(field))
}

fn out_of_bounds(pc: usize, index: i64, len: usize) -> V {
    Fault::value("IndexOutOfBounds", pc, Detail::Index(index, len))
}

fn invalid_argument(pc: usize, op: &'static str) -> V {
    Fault::value("InvalidArgument", pc, Detail::Operation(op))
}

fn resource_limit(pc: usize, resource: &'static str) -> V {
    Fault::value("ResourceLimit", pc, Detail::Resource(resource))
}

/// Struct fields can be addressed by number, as in tuple structs.
fn field_key(object: &V, key: V) -> V {
    match (object, key) {
        (V::Record(_), V::Int(index)) if index >= 0 => V::Str(index.to_string().into()),
        (_, key) => key,
    }
}

fn index(value: V, key: V, pc: usize) -> V {
    let key = field_key(&value, key);
    match (value, key) {
        (V::Error(error), V::Tag(_)) => V::Tag(error.tag().into()),
        (_, V::Tag(_)) => V::Nil,
        // Only the Error's own payload can be read; see the VM's `index_value`.
        (V::Error(error), V::Str(field)) => match error.field(&field) {
            Some(value) => value,
            None => V::Error(error),
        },
        (error @ V::Error(_), _) | (_, error @ V::Error(_)) => error,
        (V::Array(array), V::Int(index)) => {
            let Ok(items) = array.items.try_borrow() else {
                return invalid_argument(pc, "index");
            };
            usize::try_from(index)
                .ok()
                .and_then(|index| items.get(index))
                .cloned()
                .unwrap_or_else(|| out_of_bounds(pc, index, items.len()))
        }
        (V::Record(record), V::Str(field)) => match record.get(&field) {
            Some(Some(value)) => value,
            Some(None) => missing_field(field, pc),
            None => invalid_argument(pc, "index"),
        },
        _ => type_mismatch(pc, "index"),
    }
}

/// `object[key] = value`. An Error receiver or key propagates without a write;
/// an Error value is stored like any other leaf.
fn index_set(object: V, key: V, value: V, pc: usize) -> V {
    let key = field_key(&object, key);
    match (object, key) {
        (error @ V::Error(_), _) | (_, error @ V::Error(_)) => error,
        (V::Array(array), V::Int(index)) => match array_set(&array, index, value, pc) {
            Ok(()) => V::Array(array),
            Err(error) => error,
        },
        (V::Record(record), V::Str(field)) => match record_set(&record, field, value, pc) {
            Ok(()) => V::Record(record),
            Err(error) => error,
        },
        _ => type_mismatch(pc, "indexset"),
    }
}

fn native<const N: usize>(operation: fn([V; N], usize) -> V, pc: usize, arguments: [V; N]) -> V {
    operation(arguments, pc)
}

fn process_args(_: [V; 0], pc: usize) -> V {
    let mut args = Vec::new();
    for argument in std::env::args_os().skip(1) {
        let Some(text) = argument.to_str() else {
            return Fault::value("ParseFailure", pc, Detail::Parse("OS argument", "str"));
        };
        args.push(V::Str(text.into()));
    }
    make_typed_array(args, &Ty::Str, "array", pc)
}

fn stdout(_: [V; 0], _: usize) -> V {
    V::Stdout
}

fn check_native(
    value: V,
    predicate: impl FnOnce(&V) -> bool,
    pc: usize,
    op: &'static str,
) -> Result<V, V> {
    if matches!(value, V::Error(_)) {
        Err(value)
    } else if predicate(&value) {
        Ok(value)
    } else {
        Err(type_mismatch(pc, op))
    }
}

fn to_bytes([value]: [V; 1], pc: usize) -> V {
    match value {
        V::Str(text) => new_bytes(text.as_bytes().to_vec()),
        V::Error(_) => value,
        _ => type_mismatch(pc, "bytes::from_str"),
    }
}

fn new_bytes(bytes: Vec<u8>) -> V {
    V::Bytes(Rc::new(RefCell::new(bytes)))
}

/// Traversal depth is bounded like the VM's renderer, so cyclic and deeply
/// nested values report `ResourceLimit` instead of exhausting the stack.
const MAX_DEPTH: usize = 64;

fn push_text(out: &mut String, text: &str, resource: &'static str) -> Result<(), &'static str> {
    out.try_reserve(text.len()).map_err(|_| resource)?;
    out.push_str(text);
    Ok(())
}

fn render_fields(
    out: &mut String,
    fields: &[(Rc<str>, V)],
    depth: usize,
    resource: &'static str,
) -> Result<(), &'static str> {
    let mut fields = fields.iter().collect::<Vec<_>>();
    fields.sort_by(|a, b| a.0.cmp(&b.0));
    for (position, (name, value)) in fields.into_iter().enumerate() {
        if position > 0 {
            push_text(out, ", ", resource)?;
        }
        push_text(out, name, resource)?;
        push_text(out, ": ", resource)?;
        render_value(out, value, depth + 1, resource)?;
    }
    Ok(())
}

/// Append the VM's text form of `value`. The error names the exceeded resource.
fn render_value(
    out: &mut String,
    value: &V,
    depth: usize,
    resource: &'static str,
) -> Result<(), &'static str> {
    if depth >= MAX_DEPTH {
        return Err("render depth");
    }
    let put = |out: &mut String, text: &str| push_text(out, text, resource);
    match value {
        V::Int(value) => put(out, &value.to_string()),
        V::UInt(value) => put(out, &value.to_string()),
        V::Bool(value) => put(out, &value.to_string()),
        V::Char(value) => put(out, value.encode_utf8(&mut [0; 4])),
        V::Nil => put(out, "nil"),
        V::Str(value) => put(out, value),
        V::Tag(value) => put(out, &format!("<type:{value}>")),
        V::Bytes(value) => put(out, &format!("<bytes:{}>", value.borrow().len())),
        V::StrBuf(value) => put(out, &value.borrow()),
        V::Array(array) => {
            let items = array.items.try_borrow().map_err(|_| resource)?;
            put(out, "[")?;
            for (position, item) in items.iter().enumerate() {
                if position > 0 {
                    put(out, ", ")?;
                }
                render_value(out, item, depth + 1, resource)?;
            }
            put(out, "]")
        }
        V::Record(record) => {
            let fields = record.fields.try_borrow().map_err(|_| resource)?;
            put(out, "{")?;
            render_fields(out, &fields, depth, resource)?;
            put(out, "}")
        }
        V::Iterator(_) => put(out, "<iterator>"),
        V::Stdout => put(out, "<resource>"),
        V::Error(_) => {
            put(out, "Error: ")?;
            render_error_message(out, value, depth, resource)
        }
    }
}

/// Append an Error's text without the leading `Error: ` label. Other values
/// append nothing.
fn render_error_message(
    out: &mut String,
    value: &V,
    depth: usize,
    resource: &'static str,
) -> Result<(), &'static str> {
    let V::Error(error) = value else {
        return Ok(());
    };
    match &error.detail {
        Detail::Fields(fields) => {
            push_text(out, "Error::", resource)?;
            push_text(out, &error.kind, resource)?;
            push_text(out, "(", resource)?;
            render_fields(out, &fields.0, depth, resource)?;
            push_text(out, ")", resource)
        }
        _ => push_text(out, &error.message(), resource),
    }
}

fn render([value]: [V; 1], pc: usize) -> V {
    let mut text = String::new();
    match render_value(&mut text, &value, 0, "bytes") {
        Ok(()) => new_bytes(text.into_bytes()),
        Err(resource) => resource_limit(pc, resource),
    }
}

fn error_message([value]: [V; 1], pc: usize) -> V {
    let mut text = String::new();
    match render_error_message(&mut text, &value, 0, "str") {
        Ok(()) => V::Str(text.into()),
        Err(resource) => resource_limit(pc, resource),
    }
}

fn bytes_len([value]: [V; 1], pc: usize) -> V {
    match value {
        V::Bytes(bytes) => V::Int(bytes.borrow().len() as i64),
        V::Error(_) => value,
        _ => type_mismatch(pc, "bytes::len"),
    }
}

/// Native parameter kinds. The VM checks them in order: an Error in a typed
/// parameter is returned unchanged before a later parameter can mismatch.
#[derive(Clone, Copy)]
enum T {
    Any,
    Int,
    Str,
    Bytes,
    StrBuf,
}

fn check<const N: usize>(arguments: &[V; N], types: [T; N], pc: usize, op: &'static str) -> Option<V> {
    for (value, ty) in arguments.iter().zip(types) {
        if !matches!(ty, T::Any) && matches!(value, V::Error(_)) {
            return Some(value.clone());
        }
        let accepted = matches!(
            (ty, value),
            (T::Any, _)
                | (T::Int, V::Int(_))
                | (T::Str, V::Str(_))
                | (T::Bytes, V::Bytes(_))
                | (T::StrBuf, V::StrBuf(_))
        );
        if !accepted {
            return Some(type_mismatch(pc, op));
        }
    }
    None
}

fn invalid_range() -> Detail {
    Detail::Operation("bytes range")
}

/// The VM's `range` helper: a non-negative offset and count inside the buffer.
fn byte_range(offset: i64, count: i64, len: usize) -> Option<std::ops::Range<usize>> {
    let offset = usize::try_from(offset).ok()?;
    let end = offset.checked_add(usize::try_from(count).ok()?)?;
    (end <= len).then_some(offset..end)
}

fn bytes_new(arguments: [V; 1], pc: usize) -> V {
    if let Some(error) = check(&arguments, [T::Int], pc, "bytes::new") {
        return error;
    }
    let [V::Int(size)] = arguments else { unreachable!() };
    let limit = || Fault::value("ResourceLimit", pc, Detail::Resource("bytes"));
    let Ok(size) = usize::try_from(size) else {
        return limit();
    };
    let mut bytes = Vec::new();
    if bytes.try_reserve_exact(size).is_err() {
        return limit();
    }
    bytes.resize(size, 0);
    new_bytes(bytes)
}

fn bytes_get(arguments: [V; 2], pc: usize) -> V {
    if let Some(error) = check(&arguments, [T::Bytes, T::Int], pc, "bytes::get") {
        return error;
    }
    let [V::Bytes(bytes), V::Int(offset)] = arguments else { unreachable!() };
    let bytes = bytes.borrow();
    match byte_range(offset, 1, bytes.len()) {
        Some(span) => V::Int(bytes[span.start] as i64),
        None => Fault::value("InvalidArgument", pc, invalid_range()),
    }
}

fn bytes_set(arguments: [V; 3], pc: usize) -> V {
    if let Some(error) = check(&arguments, [T::Bytes, T::Int, T::Int], pc, "bytes::set") {
        return error;
    }
    let [V::Bytes(bytes), V::Int(offset), V::Int(value)] = arguments else { unreachable!() };
    let mut bytes = bytes.borrow_mut();
    let Some(span) = byte_range(offset, 1, bytes.len()) else {
        return Fault::value("InvalidArgument", pc, invalid_range());
    };
    let Ok(value) = u8::try_from(value) else {
        return Fault::value("InvalidArgument", pc, Detail::Operation("bytes::set"));
    };
    bytes[span.start] = value;
    V::Nil
}

fn bytes_to_str(arguments: [V; 3], pc: usize) -> V {
    if let Some(error) = check(&arguments, [T::Bytes, T::Int, T::Int], pc, "bytes::to_str") {
        return error;
    }
    let [V::Bytes(bytes), V::Int(offset), V::Int(count)] = arguments else { unreachable!() };
    let bytes = bytes.borrow();
    let Some(span) = byte_range(offset, count, bytes.len()) else {
        return Fault::value("InvalidArgument", pc, invalid_range());
    };
    match std::str::from_utf8(&bytes[span]) {
        Ok(text) => V::Str(text.into()),
        Err(_) => Fault::value("ParseFailure", pc, Detail::Parse("bytes", "str")),
    }
}

fn parse_failure(pc: usize, to: &'static str) -> V {
    Fault::value("ParseFailure", pc, Detail::Parse("str", to))
}

fn to_int([value]: [V; 1], pc: usize) -> V {
    match value {
        V::Error(_) | V::Int(_) => value,
        V::UInt(value) => i64::try_from(value).map_or_else(|_| Fault::value("Overflow", pc, Detail::None), V::Int),
        V::Str(text) => text.parse().map_or_else(|_| parse_failure(pc, "int"), V::Int),
        _ => type_mismatch(pc, "str::to_int"),
    }
}

fn to_uint([value]: [V; 1], pc: usize) -> V {
    match value {
        V::Error(_) | V::UInt(_) => value,
        V::Int(value) => u64::try_from(value).map_or_else(|_| Fault::value("Overflow", pc, Detail::None), V::UInt),
        V::Str(text) => text.parse().map_or_else(|_| parse_failure(pc, "uint"), V::UInt),
        _ => type_mismatch(pc, "str::to_uint"),
    }
}

fn to_bool([value]: [V; 1], pc: usize) -> V {
    match value {
        V::Error(_) | V::Bool(_) => value,
        V::Str(text) => match &*text {
            "true" => V::Bool(true),
            "false" => V::Bool(false),
            _ => parse_failure(pc, "bool"),
        },
        _ => type_mismatch(pc, "str::to_bool"),
    }
}

fn to_char([value]: [V; 1], pc: usize) -> V {
    match value {
        V::Error(_) | V::Char(_) => value,
        V::Str(text) => {
            let mut chars = text.chars();
            match (chars.next(), chars.next()) {
                (Some(character), None) => V::Char(character),
                _ => parse_failure(pc, "char"),
            }
        }
        _ => type_mismatch(pc, "str::to_char"),
    }
}

fn str_builder(_: [V; 0], _: usize) -> V {
    V::StrBuf(Rc::new(RefCell::new(String::new())))
}

fn str_build(arguments: [V; 1], pc: usize) -> V {
    if let Some(error) = check(&arguments, [T::StrBuf], pc, "str::build") {
        return error;
    }
    let [V::StrBuf(buffer)] = arguments else { unreachable!() };
    // Snapshot: later writes through any builder alias cannot change this str.
    let text = buffer.borrow();
    V::Str(text.as_str().into())
}

fn fmt_write(arguments: [V; 3], pc: usize) -> V {
    if let Some(error) = check(&arguments, [T::StrBuf, T::Str, T::Any], pc, "fmt::write") {
        return error;
    }
    let [V::StrBuf(buffer), V::Str(template), value] = arguments else { unreachable!() };
    if matches!(value, V::Error(_)) {
        return value;
    }
    // Only the first `{}` is a placeholder. The value is rendered before the
    // buffer is borrowed, so a builder may be written into itself.
    let (prefix, rendered, suffix) = match template.find("{}") {
        Some(position) => {
            let mut rendered = String::new();
            if let Err(resource) = render_value(&mut rendered, &value, 0, "str") {
                return resource_limit(pc, resource);
            }
            (&template[..position], rendered, &template[position + 2..])
        }
        None => (&*template, String::new(), ""),
    };
    let mut text = buffer.borrow_mut();
    text.push_str(prefix);
    text.push_str(&rendered);
    text.push_str(suffix);
    drop(text);
    V::StrBuf(buffer)
}

/// An Error or str passes through; any other value becomes its rendered text.
fn to_str([value]: [V; 1], pc: usize) -> V {
    if matches!(value, V::Error(_) | V::Str(_)) {
        return value;
    }
    let mut text = String::new();
    match render_value(&mut text, &value, 0, "str") {
        Ok(()) => V::Str(text.into()),
        Err(resource) => resource_limit(pc, resource),
    }
}

/// Build a struct or a core Error from `MakeRecord` entries. The compiler
/// verified statically that the record is one of the two.
fn make_record(entries: Vec<(V, V)>, pc: usize) -> V {
    let mut fields: Vec<(Rc<str>, V)> = Vec::new();
    let mut tag = None;
    let mut error = None;
    for (key, value) in entries {
        match key {
            V::Tag(name) if tag.is_none() => tag = Some(name),
            V::Str(key) => match fields.iter_mut().find(|(name, _)| *name == key) {
                Some(slot) => slot.1 = value,
                None => fields.push((key, value)),
            },
            V::Error(_) if error.is_none() => error = Some(key),
            _ if error.is_none() => error = Some(type_mismatch(pc, "record")),
            _ => {}
        }
    }
    if let Some(error) = error {
        return error;
    }
    let Some(tag) = tag else {
        return type_mismatch(pc, "record");
    };
    if let Some(name) = tag.strip_prefix("@struct::") {
        return V::Record(Rc::new(RecordObj {
            name: name.into(),
            fields: RefCell::new(fields),
            types: RefCell::new(Vec::new()),
        }));
    }
    V::Error(Fault {
        kind: Cow::Owned(tag.rsplit("::").next().unwrap_or(&tag).to_owned()),
        pc,
        detail: Detail::Fields(Rc::new(Fields(fields))),
    })
}

fn io_result(result: std::io::Result<()>, pc: usize) -> V {
    result.map_or_else(
        |error| {
            Fault::value(
                "IoWriteFailed",
                pc,
                Detail::IoWrite(error.to_string().into()),
            )
        },
        |()| V::Nil,
    )
}

fn write_all([handle, bytes, offset, count]: [V; 4], pc: usize) -> V {
    for (value, valid) in [
        (&handle, matches!(handle, V::Stdout)),
        (&bytes, matches!(bytes, V::Bytes(_))),
        (&offset, matches!(offset, V::Int(_))),
        (&count, matches!(count, V::Int(_))),
    ] {
        if let V::Error(_) = value {
            return value.clone();
        }
        if !valid {
            return type_mismatch(pc, "io::write_all");
        }
    }
    let (V::Bytes(bytes), V::Int(offset), V::Int(count)) = (bytes, offset, count) else {
        unreachable!()
    };
    let bytes = bytes.borrow();
    let range = usize::try_from(offset)
        .ok()
        .zip(usize::try_from(count).ok())
        .and_then(|(offset, count)| bytes.get(offset..offset.checked_add(count)?));
    match range {
        Some(bytes) => io_result(std::io::stdout().lock().write_all(bytes), pc),
        None => Fault::value("InvalidArgument", pc, Detail::Operation("bytes range")),
    }
}

fn flush([handle]: [V; 1], pc: usize) -> V {
    match check_native(handle, |value| matches!(value, V::Stdout), pc, "io::flush") {
        Ok(_) => io_result(std::io::stdout().lock().flush(), pc),
        Err(error) => error,
    }
}

/// Runtime array and field contracts, mirroring the VM's runtime types for the
/// values this guest can hold.
#[derive(Clone, PartialEq)]
enum Ty {
    Int,
    UInt,
    Bool,
    Char,
    Str,
    Nil,
    /// The type of an array whose elements are all Errors.
    Error,
    /// Opaque host values, and the unknown element type of an empty array.
    Other,
    Array(Rc<Ty>),
    Nullable(Rc<Ty>),
    Nominal(Rc<str>),
}

const BYTES_TYPE: &str = "$core::bytes";

struct ArrayObj {
    items: RefCell<Vec<V>>,
    /// `None` until an annotation or the first value fixes the element type.
    element: RefCell<Option<Ty>>,
    /// Changes with the length, which invalidates active iteration.
    version: Cell<u64>,
}

struct RecordObj {
    name: Rc<str>,
    fields: RefCell<Vec<(Rc<str>, V)>>,
    types: RefCell<Vec<(&'static str, Ty)>>,
}

impl RecordObj {
    /// The outer `None` reports a conflicting borrow.
    fn get(&self, name: &str) -> Option<Option<V>> {
        let fields = self.fields.try_borrow().ok()?;
        Some(
            fields
                .iter()
                .find(|(key, _)| &**key == name)
                .map(|(_, value)| value.clone()),
        )
    }
}

/// Payload of a constructed core Error value.
struct Fields(Vec<(Rc<str>, V)>);

// Containers release their children through a worklist. Dropping a long linked
// structure recursively would overflow the Wasm stack.
fn release(mut pending: Vec<V>) {
    while let Some(value) = pending.pop() {
        match value {
            V::Array(array) => {
                if let Some(mut array) = Rc::into_inner(array) {
                    pending.append(array.items.get_mut());
                }
            }
            V::Record(record) => {
                if let Some(mut record) = Rc::into_inner(record) {
                    pending.extend(record.fields.get_mut().drain(..).map(|(_, value)| value));
                }
            }
            V::Error(Fault {
                detail: Detail::Fields(fields),
                ..
            }) => {
                if let Some(mut fields) = Rc::into_inner(fields) {
                    pending.extend(fields.0.drain(..).map(|(_, value)| value));
                }
            }
            _ => {}
        }
    }
}

impl Drop for ArrayObj {
    fn drop(&mut self) {
        release(std::mem::take(self.items.get_mut()));
    }
}

impl Drop for RecordObj {
    fn drop(&mut self) {
        let fields = self.fields.get_mut().drain(..);
        release(fields.map(|(_, value)| value).collect());
    }
}

impl Drop for Fields {
    fn drop(&mut self) {
        release(self.0.drain(..).map(|(_, value)| value).collect());
    }
}

fn type_depth(ty: &Ty) -> usize {
    match ty {
        Ty::Array(inner) | Ty::Nullable(inner) => type_depth(inner) + 1,
        _ => 1,
    }
}

/// An array with this element type would exceed the VM's type depth limit.
fn too_deep(element: &Ty) -> bool {
    type_depth(element) >= MAX_DEPTH
}

/// An array holding this value would exceed the VM's type depth limit.
fn child_too_deep(value: &V) -> bool {
    match value {
        V::Array(array) => array
            .element
            .try_borrow()
            .is_ok_and(|element| element.as_ref().map_or(1, type_depth) + 2 > MAX_DEPTH),
        _ => false,
    }
}

fn element_type(array: &ArrayObj) -> Option<Ty> {
    array
        .element
        .try_borrow()
        .ok()
        .and_then(|element| element.clone())
}

fn type_of(value: &V) -> Ty {
    match value {
        V::Int(_) => Ty::Int,
        V::UInt(_) => Ty::UInt,
        V::Bool(_) => Ty::Bool,
        V::Char(_) => Ty::Char,
        V::Nil => Ty::Nil,
        V::Str(_) | V::StrBuf(_) => Ty::Str,
        V::Error(_) => Ty::Error,
        V::Array(array) => Ty::Array(Rc::new(element_type(array).unwrap_or(Ty::Other))),
        V::Record(record) => Ty::Nominal(record.name.clone()),
        V::Bytes(_) => Ty::Nominal(BYTES_TYPE.into()),
        V::Tag(_) | V::Stdout | V::Iterator(_) => Ty::Other,
    }
}

fn undetermined(ty: &Ty) -> bool {
    match ty {
        Ty::Array(element) => **element == Ty::Other || undetermined(element),
        Ty::Nullable(inner) => undetermined(inner),
        _ => false,
    }
}

fn needs_type_context(array: &ArrayObj) -> bool {
    element_type(array).as_ref().is_none_or(undetermined)
}

/// Parameter and result contracts compare types without inspecting elements.
fn matches_type(expected: &Ty, value: &V) -> bool {
    match (expected, value) {
        (_, V::Error(_)) | (Ty::Nullable(_), V::Nil) => true,
        (Ty::Nullable(inner), value) => matches_type(inner, value),
        (Ty::Array(inner), V::Array(array)) => array
            .element
            .try_borrow()
            .is_ok_and(|element| element.as_ref().unwrap_or(&Ty::Other) == &**inner),
        (Ty::Nominal(name), V::Record(record)) => *name == record.name,
        (Ty::Nominal(name), V::Bytes(_)) => &**name == BYTES_TYPE,
        (Ty::Other, V::Stdout | V::Iterator(_))
        | (Ty::Int, V::Int(_))
        | (Ty::UInt, V::UInt(_))
        | (Ty::Bool, V::Bool(_))
        | (Ty::Char, V::Char(_))
        | (Ty::Nil, V::Nil)
        | (Ty::Str, V::Str(_) | V::StrBuf(_)) => true,
        _ => false,
    }
}

/// Element types that one validation has already assigned to arrays.
type Seen<'a> = HashMap<*const ArrayObj, &'a Ty>;

/// Check without mutation that `value` can satisfy `expected`. Errors are
/// accepted anywhere. Recursion is bounded by the depth of `expected`.
fn validate<'a>(expected: &'a Ty, value: &V, seen: &mut Seen<'a>) -> bool {
    match (expected, value) {
        (_, V::Error(_)) | (Ty::Nullable(_), V::Nil) => true,
        (Ty::Nullable(inner), value) => validate(inner, value, seen),
        (Ty::Array(inner), V::Array(array)) => validate_array(array, inner, seen),
        (expected, value) => matches_type(expected, value),
    }
}

fn validate_array<'a>(array: &ArrayObj, expected: &'a Ty, seen: &mut Seen<'a>) -> bool {
    let identity: *const ArrayObj = array;
    let Ok(current) = array.element.try_borrow() else {
        return false;
    };
    if let Some(actual) = seen.get(&identity).copied().or(current.as_ref())
        && actual != expected
        && !matches!((expected, actual),
            (Ty::Array(_), Ty::Array(inner)) if **inner == Ty::Other)
    {
        return false;
    }
    seen.insert(identity, expected);
    array
        .items
        .try_borrow()
        .is_ok_and(|items| items.iter().all(|item| validate(expected, item, seen)))
}

/// Fix the types of nested arrays. `validate` must have succeeded first.
fn apply(expected: &Ty, value: &V) -> bool {
    match (expected, value) {
        (Ty::Nullable(inner), value) => matches!(value, V::Nil) || apply(inner, value),
        (Ty::Array(inner), V::Array(array)) => apply_array(array, inner),
        _ => true,
    }
}

fn apply_array(array: &ArrayObj, expected: &Ty) -> bool {
    let Ok(items) = array.items.try_borrow() else {
        return false;
    };
    // Only nested array contracts change anything below this level.
    if matches!(expected, Ty::Array(_) | Ty::Nullable(_))
        && !items.iter().all(|item| apply(expected, item))
    {
        return false;
    }
    let Ok(mut element) = array.element.try_borrow_mut() else {
        return false;
    };
    if element.as_ref() != Some(expected) {
        *element = Some(expected.clone());
    }
    true
}

fn constrain_array(array: &ArrayObj, expected: &Ty) -> bool {
    validate_array(array, expected, &mut Seen::new()) && apply_array(array, expected)
}

/// Validate every value in one session before changing any of them.
fn constrain_values(expected: &Ty, values: &[V]) -> bool {
    let mut seen = Seen::new();
    values
        .iter()
        .all(|value| validate(expected, value, &mut seen))
        && values.iter().all(|value| apply(expected, value))
}

fn wrap_array(items: Vec<V>, element: Option<Ty>) -> V {
    V::Array(Rc::new(ArrayObj {
        items: RefCell::new(items),
        element: RefCell::new(element),
        version: Cell::new(0),
    }))
}

/// An untyped literal infers its element type from the first normal value.
fn make_array(items: Vec<V>, op: &'static str, pc: usize) -> V {
    if items.iter().any(child_too_deep) {
        return resource_limit(pc, "array type depth");
    }
    let infer = |value: &V| Some(type_of(value)).filter(|ty| !undetermined(ty));
    let element = items
        .iter()
        .filter(|value| !matches!(value, V::Error(_)))
        .find_map(infer)
        .or_else(|| items.iter().find_map(infer));
    match &element {
        None if !items.is_empty() => type_mismatch(pc, op),
        Some(expected) if !constrain_values(expected, &items) => type_mismatch(pc, op),
        _ => wrap_array(items, element),
    }
}

fn make_typed_array(items: Vec<V>, expected: &Ty, op: &'static str, pc: usize) -> V {
    if too_deep(expected) {
        return resource_limit(pc, "array type depth");
    }
    if !constrain_values(expected, &items) {
        return type_mismatch(pc, op);
    }
    wrap_array(items, Some(expected.clone()))
}

fn constrain_array_type(value: V, expected: &Ty, pc: usize) -> V {
    match value {
        V::Array(_) if too_deep(expected) => resource_limit(pc, "array type depth"),
        V::Array(array) if constrain_array(&array, expected) => V::Array(array),
        V::Error(_) => value,
        _ => type_mismatch(pc, "array_type"),
    }
}

/// Assignment lets an untyped array inherit the type of the replaced one.
fn constrain_array_from(value: V, template: V, pc: usize) -> V {
    match (value, template) {
        (V::Array(array), _) if !needs_type_context(&array) => V::Array(array),
        (V::Array(array), V::Array(template)) => {
            if element_type(&template).is_some_and(|ty| constrain_array(&array, &ty)) {
                V::Array(array)
            } else {
                type_mismatch(pc, "array_type")
            }
        }
        (V::Array(_), _) => type_mismatch(pc, "array_type"),
        (value, _) => value,
    }
}

fn empty_like(value: V, pc: usize) -> V {
    match value {
        V::Array(array) => match element_type(&array) {
            Some(element) => make_typed_array(Vec::new(), &element, "array_empty_like", pc),
            None => type_mismatch(pc, "array_empty_like"),
        },
        V::Error(_) => value,
        _ => type_mismatch(pc, "array_empty_like"),
    }
}

/// Insert in place, so every alias observes the new element.
fn insert(array: &ArrayObj, value: V, front: bool, pc: usize) -> Result<(), V> {
    let op = if front { "arrprepend" } else { "arrpush" };
    // `Some` holds the element type that this first value establishes.
    let first = {
        let Ok(element) = array.element.try_borrow() else {
            return Err(invalid_argument(pc, op));
        };
        match element.as_ref() {
            Some(expected) => {
                if !validate(expected, &value, &mut Seen::new()) {
                    return Err(type_mismatch(pc, op));
                }
                None
            }
            None => {
                if child_too_deep(&value) {
                    return Err(resource_limit(pc, "array type depth"));
                }
                let actual = type_of(&value);
                if undetermined(&actual) {
                    return Err(type_mismatch(pc, op));
                }
                Some(actual)
            }
        }
    };
    let Ok(mut items) = array.items.try_borrow_mut() else {
        return Err(invalid_argument(pc, op));
    };
    items
        .try_reserve(1)
        .map_err(|_| resource_limit(pc, "array"))?;
    match first {
        Some(actual) => match array.element.try_borrow_mut() {
            Ok(mut element) => *element = Some(actual),
            Err(_) => return Err(invalid_argument(pc, op)),
        },
        None => {
            let Ok(element) = array.element.try_borrow() else {
                return Err(invalid_argument(pc, op));
            };
            if !element.as_ref().is_none_or(|ty| apply(ty, &value)) {
                return Err(type_mismatch(pc, op));
            }
        }
    }
    if front {
        items.insert(0, value);
    } else {
        items.push(value);
    }
    array.version.set(array.version.get().wrapping_add(1));
    Ok(())
}

/// `array.append(value)`. An Error operand is returned and nothing is inserted.
fn array_push(array: V, value: V, pc: usize) -> V {
    match (array, value) {
        (error @ V::Error(_), _) | (_, error @ V::Error(_)) => error,
        (V::Array(array), value) => match insert(&array, value, false, pc) {
            Ok(()) => V::Array(array),
            Err(error) => error,
        },
        _ => type_mismatch(pc, "arrpush"),
    }
}

/// `array.prepend(value)`. The value operand is checked for an Error first.
fn array_prepend(value: V, array: V, pc: usize) -> V {
    match (value, array) {
        (error @ V::Error(_), _) | (_, error @ V::Error(_)) => error,
        (value, V::Array(array)) => match insert(&array, value, true, pc) {
            Ok(()) => V::Array(array),
            Err(error) => error,
        },
        _ => type_mismatch(pc, "arrprepend"),
    }
}

fn array_set(array: &ArrayObj, index: i64, value: V, pc: usize) -> Result<(), V> {
    let Ok(len) = array.items.try_borrow().map(|items| items.len()) else {
        return Err(invalid_argument(pc, "indexset"));
    };
    let Some(position) = usize::try_from(index).ok().filter(|i| *i < len) else {
        return Err(out_of_bounds(pc, index, len));
    };
    {
        let Ok(element) = array.element.try_borrow() else {
            return Err(invalid_argument(pc, "indexset"));
        };
        // A non-empty array always has an element type.
        if let Some(expected) = element.as_ref()
            && !(validate(expected, &value, &mut Seen::new()) && apply(expected, &value))
        {
            return Err(type_mismatch(pc, "indexset"));
        }
    }
    let Ok(mut items) = array.items.try_borrow_mut() else {
        return Err(invalid_argument(pc, "indexset"));
    };
    let previous = std::mem::replace(&mut items[position], value);
    // The replaced value may be the last reference to a graph that leads back.
    drop(items);
    drop(previous);
    Ok(())
}

fn copy_into(target: &mut Vec<V>, array: &ArrayObj, pc: usize) -> Result<(), V> {
    let Ok(items) = array.items.try_borrow() else {
        return Err(invalid_argument(pc, "array_concat"));
    };
    target
        .try_reserve(items.len())
        .map_err(|_| resource_limit(pc, "array"))?;
    target.extend(items.iter().cloned());
    Ok(())
}

fn concatenated(items: Vec<V>, element: Option<Ty>, pc: usize) -> V {
    match element {
        Some(element) => make_typed_array(items, &element, "array_concat", pc),
        None => make_array(items, "array_concat", pc),
    }
}

/// `array + other` builds a new array from two arrays or one extra element.
fn append_to_copy(left: &ArrayObj, right: V, pc: usize) -> V {
    let mut items = Vec::new();
    if let Err(error) = copy_into(&mut items, left, pc) {
        return error;
    }
    let mut element = element_type(left);
    if let V::Array(right) = &right {
        let other = element_type(right);
        if element
            .as_ref()
            .zip(other.as_ref())
            .is_some_and(|(left, right)| left != right)
        {
            return type_mismatch(pc, "array_concat");
        }
        if let Err(error) = copy_into(&mut items, right, pc) {
            return error;
        }
        element = element.or(other);
    } else {
        if items.try_reserve(1).is_err() {
            return resource_limit(pc, "array");
        }
        items.push(right);
    }
    concatenated(items, element, pc)
}

fn prepend_to_copy(first: V, rest: &ArrayObj, pc: usize) -> V {
    let mut items = vec![first];
    if let Err(error) = copy_into(&mut items, rest, pc) {
        return error;
    }
    concatenated(items, element_type(rest), pc)
}

/// Fix the declared field types of a newly constructed struct.
fn constrain_fields(value: V, contracts: &[(&'static str, &Ty)], pc: usize) -> V {
    let record = match value {
        V::Record(record) => record,
        V::Error(_) => return value,
        _ => return type_mismatch(pc, "record_type"),
    };
    {
        let Ok(fields) = record.fields.try_borrow() else {
            return invalid_argument(pc, "record_type");
        };
        let field = |name: &str| fields.iter().find(|(key, _)| &**key == name);
        let mut seen = Seen::new();
        for &(name, expected) in contracts {
            if too_deep(expected) {
                return resource_limit(pc, "array type depth");
            }
            if !field(name).is_some_and(|(_, value)| validate(expected, value, &mut seen)) {
                return type_mismatch(pc, "record_type");
            }
        }
        for &(name, expected) in contracts {
            if !field(name).is_some_and(|(_, value)| apply(expected, value)) {
                return type_mismatch(pc, "record_type");
            }
        }
    }
    let Ok(mut types) = record.types.try_borrow_mut() else {
        return invalid_argument(pc, "record_type");
    };
    *types = contracts
        .iter()
        .map(|&(name, ty)| (name, ty.clone()))
        .collect();
    drop(types);
    V::Record(record)
}

fn record_set(record: &RecordObj, name: Rc<str>, value: V, pc: usize) -> Result<(), V> {
    let Some(current) = record.get(&name) else {
        return Err(invalid_argument(pc, "indexset"));
    };
    // A replacement array takes the element type of the array it replaces.
    if let V::Array(replacement) = &value {
        let accepted = match &current {
            Some(V::Array(current)) => {
                element_type(current).is_some_and(|ty| constrain_array(replacement, &ty))
            }
            _ => !needs_type_context(replacement),
        };
        if !accepted {
            return Err(type_mismatch(pc, "indexset"));
        }
    }
    drop(current);
    {
        let Ok(types) = record.types.try_borrow() else {
            return Err(invalid_argument(pc, "indexset"));
        };
        if let Some((_, expected)) = types.iter().find(|(field, _)| *field == &*name)
            && !(validate(expected, &value, &mut Seen::new()) && apply(expected, &value))
        {
            return Err(type_mismatch(pc, "indexset"));
        }
    }
    let Ok(mut fields) = record.fields.try_borrow_mut() else {
        return Err(invalid_argument(pc, "indexset"));
    };
    let previous = match fields.iter_mut().find(|(key, _)| *key == name) {
        Some(slot) => Some(std::mem::replace(&mut slot.1, value)),
        None => {
            fields.push((name, value));
            None
        }
    };
    // The replaced value may be the last reference to a graph that leads back.
    drop(fields);
    drop(previous);
    Ok(())
}

/// State of a `for` loop over an array or the characters of a string.
struct Iteration {
    source: V,
    /// Element index of an array, or byte offset of a string.
    position: usize,
    version: u64,
    current: Option<V>,
}

impl Iteration {
    fn advance(&mut self, pc: usize) -> V {
        self.current = None;
        match &self.source {
            V::Array(array) => {
                if array.version.get() != self.version {
                    return invalid_argument(pc, "array iteration invalidated");
                }
                let Ok(items) = array.items.try_borrow() else {
                    return invalid_argument(pc, "array iteration");
                };
                self.current = items.get(self.position).cloned();
                self.position += usize::from(self.current.is_some());
            }
            V::Str(text) => {
                let Some(rest) = text.get(self.position..) else {
                    return invalid_argument(pc, "string iteration");
                };
                if let Some(character) = rest.chars().next() {
                    self.position += character.len_utf8();
                    self.current = Some(V::Char(character));
                }
            }
            _ => return type_mismatch(pc, "for iteration"),
        }
        V::Bool(self.current.is_some())
    }
}

fn iterator_new([source]: [V; 1], pc: usize) -> V {
    let version = match &source {
        V::Array(array) => array.version.get(),
        V::Str(_) => 0,
        V::Error(_) => return source,
        _ => return type_mismatch(pc, "for iteration"),
    };
    V::Iterator(Rc::new(RefCell::new(Iteration {
        source,
        position: 0,
        version,
        current: None,
    })))
}

fn iterator_next([iterator]: [V; 1], pc: usize) -> V {
    match &iterator {
        V::Iterator(state) => match state.try_borrow_mut() {
            Ok(mut state) => state.advance(pc),
            Err(_) => invalid_argument(pc, "iterator borrow"),
        },
        V::Error(_) => iterator,
        _ => type_mismatch(pc, "iterator next"),
    }
}

fn iterator_current([iterator]: [V; 1], pc: usize) -> V {
    match &iterator {
        V::Iterator(state) => match state.try_borrow() {
            Ok(state) => state
                .current
                .clone()
                .unwrap_or_else(|| invalid_argument(pc, "iterator has no current value")),
            Err(_) => invalid_argument(pc, "iterator borrow"),
        },
        V::Error(_) => iterator,
        _ => type_mismatch(pc, "iterator current"),
    }
}
