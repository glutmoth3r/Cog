@!include("std")
use async::fs;
use async::io as aio;
use bytes;
use io;

@async fn main() -> nil {
    const path = ".cog-async-file-handle-demo.txt";
    const extra_path = ".cog-async-file-handle-extra.txt";
    const file_open = spawn(aio::open(path, "w+", 64));
    const extra_open = spawn(aio::open(extra_path, "w", 0));
    const file = await file_open!!;
    const extra = await extra_open!!;
    io::close(extra)!!;
    await fs::remove_file(extra_path)!!;
    const message = bytes::from_str("file handles work with async I/O\n")!!;

    await aio::write_all(file, message)!!;
    await aio::seek(file, 0, "start")!!;
    const prefix = await aio::read_exact(file, 5)!!;
    const suffix = await aio::read_all(file)!!;
    const contents = bytes::concat(prefix, suffix)!!;
    const text = bytes::to_str(contents, 0, bytes::len(contents)!!)!!;
    io::println(text)!!;

    await aio::flush(file)!!;
    io::close(file)!!;
    await fs::remove_file(path)!!;
}
