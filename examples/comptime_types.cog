@!include("std")
use io;

@comptime fn identity_type(value: type) -> type {
    value
}

@comptime const Scalar: type = int;
@comptime const Number: type = identity_type(Scalar);
@comptime const Grid: type = Number[][];

fn first(grid: Grid) -> Number {
    grid[0][0]
}

fn main() {
    io::println(first([[42]]));
}
